# =============================================================================
# Netwatch Manager Environment Configuration
# Copy this file to .env before starting the container:
#   Linux/macOS: cp .env.example .env
#   Windows:     copy .env.example .env
# =============================================================================

# Server Port
PORT=3000

# 64-character hexadecimal key (32 bytes) for AES-256 router password encryption
# Generate new random key: openssl rand -hex 32
ENCRYPT_KEY=5c0f2edcf74b7e27a70a141ed9433f53f264bdcf95be94e772afef8ab526cc04

# Secret string used to sign JWT session cookies
# Generate new random key: openssl rand -hex 32
JWT_SECRET=88a183515ca4c845f94d93540ae3fbdb91eb582236fa120539c3c5ee7c6883ba
